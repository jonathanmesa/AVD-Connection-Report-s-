        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);let B=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State == \"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend HasTurn=coalesce(HasTurn,long(0)),HasShort=coalesce(HasShort,long(0)),HasWeb=coalesce(HasWeb,long(0))|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter})));let Total=toscalar(B|summarize count());let Direct=toscalar(B|summarize countif(Mode==\"UDP direct\"));let ManagedDirect=toscalar(B|summarize countif(Mode==\"UDP direct\" and tostring(UdpUse)==\"1\"));let PublicDirect=toscalar(B|summarize countif(Mode==\"UDP direct\" and tostring(UdpUse)==\"2\"));let Turn=toscalar(B|summarize countif(Mode==\"UDP via TURN\"));let TCP=toscalar(B|summarize countif(Mode==\"TCP fallback\"));let Unknown=toscalar(B|summarize countif(Mode==\"Unknown\"));union (print Metric=\"Sessions\",Value=todouble(Total),Description=\"Connected sessions matching the selected filters\",Sort=1),(print Metric=\"Direct UDP (%)\",Value=todouble(round(100.0*Direct/iff(Total==0,1,Total),1)),Description=\"Direct Shortpath without a TURN relay\",Sort=2),(print Metric=\"Direct UDP - managed (%)\",Value=todouble(round(100.0*ManagedDirect/iff(Total==0,1,Total),1)),Description=\"Private ExpressRoute/VPN path; documented UdpUse=1\",Sort=3),(print Metric=\"Direct UDP - public/STUN (%)\",Value=todouble(round(100.0*PublicDirect/iff(Total==0,1,Total),1)),Description=\"Public internet direct path via STUN; documented UdpUse=2\",Sort=4),(print Metric=\"Relayed UDP (%)\",Value=todouble(round(100.0*Turn/iff(Total==0,1,Total),1)),Description=\"Shortpath through a Microsoft TURN relay\",Sort=5),(print Metric=\"TCP fallback (%)\",Value=todouble(round(100.0*TCP/iff(Total==0,1,Total),1)),Description=\"Supported TCP/TLS 443; review only when UDP is expected\",Sort=6),(print Metric=\"Unknown (%)\",Value=todouble(round(100.0*Unknown/iff(Total==0,1,Total),1)),Description=\"Sessions without enough evidence to classify transport\",Sort=7)|order by Sort asc",
