        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);let C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"Direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),Transport=case(Mode==\"TURN\",\"UDP via TURN\",Mode==\"Direct\",\"UDP direct\",Mode==\"TCP\",\"TCP fallback\",\"Unknown\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,HostPool,SessionHost,UserName,Mode,UdpUse);let Mix=C|summarize Sessions=count(),Users=dcount(UserName),Direct=countif(Mode==\"Direct\"),ManagedDirect=countif(Mode==\"Direct\" and tostring(UdpUse)==\"1\"),PublicDirect=countif(Mode==\"Direct\" and tostring(UdpUse)==\"2\"),Relayed=countif(Mode==\"TURN\"),TCP=countif(Mode==\"TCP\"),Unknown=countif(Mode==\"Unknown\") by HostPool,SessionHost|extend OtherDirect=Direct-ManagedDirect-PublicDirect|extend Direct_UDP_Pct=round(100.0*Direct/iff(Sessions==0,1,Sessions),1),ManagedDirect_Pct=round(100.0*ManagedDirect/iff(Sessions==0,1,Sessions),1),PublicDirect_Pct=round(100.0*PublicDirect/iff(Sessions==0,1,Sessions),1),OtherDirect_Pct=round(100.0*OtherDirect/iff(Sessions==0,1,Sessions),1),Relayed_UDP_Pct=round(100.0*Relayed/iff(Sessions==0,1,Sessions),1),TCP_Pct=round(100.0*TCP/iff(Sessions==0,1,Sessions),1),Unknown_Pct=round(100.0*Unknown/iff(Sessions==0,1,Sessions),1);let Bandwidth=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner (C|project CorrelationId,HostPool,SessionHost) on CorrelationId|summarize SampledSessions=dcount(CorrelationId),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by HostPool,SessionHost;Mix|join kind=leftouter Bandwidth on HostPool,SessionHost|extend SampledSessions=coalesce(SampledSessions,long(0))|extend NetworkCoverage_Pct=round(100.0*SampledSessions/iff(Sessions==0,1,Sessions),1)|project HostPool,SessionHost,Sessions,Users,Direct_UDP_Pct,ManagedDirect_Pct,PublicDirect_Pct,OtherDirect_Pct,Relayed_UDP_Pct,TCP_Pct,Unknown_Pct,NetworkCoverage_Pct,AvgBandwidthMbps,P10BandwidthMbps|order by TCP_Pct desc,Unknown_Pct desc,Sessions desc",
