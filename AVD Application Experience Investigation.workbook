{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Azure Virtual Desktop Investigation\r\nUse this workbook to determine whether reported user or application issues align with the AVD network path, profile/logon delays, session-host health, graphics delivery, client versions, operational changes, or AVD errors.\r\n\r\n> **Evidence boundary:** AVD diagnostics do not directly measure application transaction times. The panels below provide AVD evidence and correlation keys; validate application-specific symptoms with the affected application's service telemetry."
      },
      "name": "AVD investigation heading",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "parameters": [
          {
            "id": "8d289b64-c63c-4a69-9e74-45ee6c6b3560",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "label": "Log Analytics workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "value": [],
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [
                "value::1"
              ],
              "showDefault": false
            }
          },
          {
            "id": "a6d078d9-816c-4a52-8d02-80f62484c247",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 604800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          }
        ],
        "style": "pills"
      },
      "name": "Dashboard parameters",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "parameters": [
          {
            "id": "ba9650db-5ac0-47a0-a094-72992eb3ec10",
            "version": "KqlParameterItem/1.0",
            "name": "HostPoolFilter",
            "label": "Host pool",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "union (print value=\"All\",label=\"All host pools\"),(WVDConnections | where TimeGenerated {TimeRange} | extend value=extract(\"/hostpools/([^/]+)\",1,_ResourceId) | extend value=iff(isempty(value),\"Unknown\",value) | distinct value | project value,label=value) | order by label asc",
            "value": [
              "All"
            ],
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "195849cd-32f5-4a82-8f72-2980467637d6",
            "version": "KqlParameterItem/1.0",
            "name": "GatewayFilter",
            "label": "Gateway region",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "union (print value=\"All\",label=\"All gateway regions\"),(WVDConnections | where TimeGenerated {TimeRange} | extend value=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion) | distinct value | project value,label=value) | order by label asc",
            "value": [
              "All"
            ],
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "b3ce66f4-ac77-40f0-b98d-d99a6959e65b",
            "version": "KqlParameterItem/1.0",
            "name": "UserFilter",
            "label": "Search or select user",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "union (print value=\"All\",label=\"All users\"),(WVDConnections | where TimeGenerated {TimeRange} | extend value=iff(isempty(UserName),\"Unknown\",UserName) | distinct value | project value,label=value) | order by label asc",
            "value": [
              "All"
            ],
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "d6553461-56cb-4286-85fd-94c29c86f2cc",
            "version": "KqlParameterItem/1.0",
            "name": "TransportFilter",
            "label": "Transport outcome",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "datatable(value:string,label:string)[\"All\",\"All transport outcomes\",\"UDP direct\",\"UDP direct\",\"UDP via TURN\",\"UDP via TURN\",\"TCP fallback\",\"TCP fallback\",\"Unknown\",\"Unknown\"]",
            "value": [
              "All"
            ],
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          }
        ],
        "style": "pills"
      },
      "name": "Investigation filters",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Start here: establish where the slowdown lives\r\n1. Confirm that **Network coverage** is representative before interpreting RTT or bandwidth.\r\n2. Use **User experience triage** to identify users with high AVD RTT, constrained bandwidth, TCP fallback, or errors.\r\n3. Check logon phases, AVD agent health, and graphics telemetry to separate profile/host-health indicators from network-path indicators.\r\n4. Export the 30-minute AVD evidence dataset and align it with reported application symptoms using user and timestamp. Correlation is evidence, not proof of application causality."
      },
      "name": "Executive triage guidance",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Risk color legend\r\n- **Red:** strong risk signal or missing required telemetry; investigate first.\r\n- **Orange:** warning threshold; compare with the complaint time and peer cohort.\r\n- **Green:** healthy against this workbook's stated threshold; it does not prove the application was healthy.\r\n- **Gray:** unknown, unavailable, or informational. Do not interpret missing evidence as success.\r\n\r\nColors route investigation; they do not assign root cause by themselves."
      },
      "name": "Risk color legend",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## How to read the dashboard\r\n1. **Coverage:** Are the required logs present? Stop here if important data is missing.\r\n2. **30-minute network timeline:** At the complaint time, were RTT, bandwidth, or TCP fallback at risk?\r\n3. **Cohort and path overview:** Are the reported users worse than peers, and how large is the AVD path risk?\r\n4. **Host, logon, health, and graphics:** Does one host or a specific session stage stand out?\r\n5. **Transport and error detail:** Use these only after a user, host, or time period has been identified.\r\n\r\nStart at the top and work downward. Red identifies the next question to investigate; it is not a root-cause finding."
      },
      "name": "How to read this dashboard",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Expected=datatable(DataSource:string,Purpose:string)[\"WVDConnections\",\"Session identity, state, client, host pool, gateway, and transport\",\"WVDMultiLinkAdd\",\"Shortpath, TURN, and WebSocket link evidence\",\"WVDConnectionNetworkData\",\"In-session AVD RTT and estimated bandwidth\",\"WVDErrors\",\"AVD service, client, connection, and environment errors\",\"WVDCheckpoints\",\"LogonDelay phase timing including profile and FSLogix\",\"WVDAgentHealthStatus\",\"Session-host agent health checks\",\"WVDConnectionGraphicsDataPreview\",\"Graphics encoding, decoding, rendering, and skipped frames\",\"WVDFeeds\",\"Workspace feed and published-resource retrieval failures\",\"WVDHostRegistrations\",\"Session-host registration activity\",\"WVDManagement\",\"AVD management operations and resource changes\",\"WVDSessionHostManagement\",\"Session-host provisioning and update activity\",\"WVDAutoscaleEvaluationPooled\",\"Autoscale occupancy, decisions, and failures\"];\r\nlet Observed=union isfuzzy=true (datatable(DataSource:string,TimeGenerated:datetime)[]),(WVDConnections|where TimeGenerated {TimeRange}|project DataSource=\"WVDConnections\",TimeGenerated),(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|project DataSource=\"WVDMultiLinkAdd\",TimeGenerated),(WVDConnectionNetworkData|where TimeGenerated {TimeRange}|project DataSource=\"WVDConnectionNetworkData\",TimeGenerated),(WVDErrors|where TimeGenerated {TimeRange}|project DataSource=\"WVDErrors\",TimeGenerated),(WVDCheckpoints|where TimeGenerated {TimeRange}|project DataSource=\"WVDCheckpoints\",TimeGenerated),(WVDAgentHealthStatus|where TimeGenerated {TimeRange}|project DataSource=\"WVDAgentHealthStatus\",TimeGenerated),(WVDConnectionGraphicsDataPreview|where TimeGenerated {TimeRange}|project DataSource=\"WVDConnectionGraphicsDataPreview\",TimeGenerated),(WVDFeeds|where TimeGenerated {TimeRange}|project DataSource=\"WVDFeeds\",TimeGenerated),(WVDHostRegistrations|where TimeGenerated {TimeRange}|project DataSource=\"WVDHostRegistrations\",TimeGenerated),(WVDManagement|where TimeGenerated {TimeRange}|project DataSource=\"WVDManagement\",TimeGenerated),(WVDSessionHostManagement|where TimeGenerated {TimeRange}|project DataSource=\"WVDSessionHostManagement\",TimeGenerated),(WVDAutoscaleEvaluationPooled|where TimeGenerated {TimeRange}|project DataSource=\"WVDAutoscaleEvaluationPooled\",TimeGenerated)|where isnotempty(DataSource)|summarize Rows=count(),LatestRecord=max(TimeGenerated) by DataSource;\r\nExpected|join kind=leftouter Observed on DataSource|extend Rows=coalesce(Rows,long(0)),Status=case(Rows==0,\"Missing or no rows in range\",LatestRecord < ago(1d),\"Present but stale\",\"Present\")|project Status,DataSource,Purpose,Rows,LatestRecord|order by Status asc,DataSource asc",
        "size": 0,
        "title": "Diagnostic coverage and data freshness",
        "description": "Shows whether each required data source has records in the selected workspace and time range. This panel intentionally ignores the user filter because it validates workspace-level diagnostic collection. Missing data is an investigation gap, not a healthy result.",
        "noDataMessage": "No data was found. Check the selected workspace, time range, and collection prerequisites.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Missing or no rows in range",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Present but stale",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Present",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Diagnostic coverage readiness",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## What would support or weaken the claim that AVD caused the slowdown?\r\n**Evidence supporting an AVD contribution:** complaining users are materially worse than peers in the same period; symptoms align with high AVD RTT, low bandwidth, TCP fallback, AVD errors, slow FSLogix/profile phases, unhealthy session hosts, unhealthy hosts, or graphics pressure; results cluster by host, host pool, gateway, client version, or time; and experience improves after a controlled AVD remediation.\r\n\r\n**Evidence weakening an AVD claim:** complaining users look the same as healthy peers; AVD network, profile, agent-health, and graphics evidence is healthy during the complaint; the issue follows an application service event, proxy, browser, sync state, media path, or document/site; or the same issue occurs outside AVD.\r\n\r\n**Minimum proof standard:** same user, same time window, measurable symptom, comparison cohort, and a repeatable before/after change. A single report or user perception alone does not isolate the cause."
      },
      "name": "AVD causality decision guide",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasUdp=countif(ClientTransportType in~ (\"TURN\",\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"TURN\",\"Shortpath\",\"DIRECT\") or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)) by CorrelationId;\r\nlet C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),HasUdp=coalesce(HasUdp,long(0))|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,ConnectedAt=TimeGenerated,HasUdp;\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner (C|project CorrelationId,ConnectedAt,HasUdp) on CorrelationId|summarize P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId,ConnectedAt,HasUdp;\r\nC|join kind=leftouter N on CorrelationId,ConnectedAt,HasUdp|summarize Sessions=count(),NetworkSessions=countif(isnotnull(P95RTTms)),TcpFallbackSessions=countif(HasUdp==0),P95RTTms=round(percentile(P95RTTms,95),1),P10BandwidthMbps=round(percentile(P10BandwidthMbps,10),2) by TimeBucket=bin(ConnectedAt,30m)|extend NetworkCoveragePct=round(100.0*NetworkSessions/iff(Sessions==0,1,Sessions),1),TcpFallbackPct=round(100.0*TcpFallbackSessions/iff(Sessions==0,1,Sessions),1)|extend Condition=case(NetworkCoveragePct<50,\"Unknown\",P95RTTms>250 or P10BandwidthMbps<5 or TcpFallbackPct>50,\"High risk\",P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20,\"Warning\",\"Normal\")|project TimeBucket,Sessions,NetworkCoveragePct,P95RTTms,P10BandwidthMbps,TcpFallbackPct,Condition|order by TimeBucket desc",
        "size": 0,
        "title": "30-minute AVD network risk at complaint time",
        "description": "Use this first when a complaint has a timestamp. Each row is a 30-minute period. High risk means P95 RTT exceeded 250 ms, P10 bandwidth fell below 5 Mbps, or more than 50% of sessions used TCP fallback. Warning uses 120 ms, 10 Mbps, and 20%. Gray means fewer than 50% of sessions had network samples, so the period cannot be judged. Compare the matching row with application telemetry.",
        "noDataMessage": "No connected-session data was found for the selected filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Condition",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "High risk",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Normal",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "AVD path condition timeline",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter}))|extend Cohort=iff('All' in ({UserFilter}),\"All users\",iff(User in ({UserFilter}),\"Selected / complaining users\",\"Other users\"))|project CorrelationId,Cohort,User,Transport);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSamples=count(),AvgRTTms=avg(EstRoundTripTimeInMs),P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nlet E=WVDErrors|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ErrorEvents=count() by CorrelationId;\r\nC|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorEvents=coalesce(ErrorEvents,long(0))|summarize Users=dcount(User),Sessions=count(),NetworkSessions=countif(NetworkSamples>0),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),SessionsWithErrors=countif(ErrorEvents>0),AvgRTTms=round(avg(AvgRTTms),1),P95RTTms=round(percentile(P95RTTms,95),1),P10BandwidthMbps=round(percentile(P10BandwidthMbps,10),2) by Cohort|extend NetworkCoveragePct=round(100.0*NetworkSessions/iff(Sessions==0,1,Sessions),1),TcpFallbackPct=round(100.0*TcpFallbackSessions/iff(Sessions==0,1,Sessions),1),SessionsWithErrorsPct=round(100.0*SessionsWithErrors/iff(Sessions==0,1,Sessions),1)|project Cohort,Users,Sessions,NetworkCoveragePct,TcpFallbackPct,SessionsWithErrorsPct,AvgRTTms,P95RTTms,P10BandwidthMbps",
        "size": 0,
        "title": "Selected complaining users compared with peers",
        "description": "Select reported users in the User filter. This panel compares them with all other users in the same host-pool, gateway, and time scope. If All users is selected, only one baseline row is shown. Meaningful differences support an AVD-related hypothesis; similar results weaken it.",
        "noDataMessage": "No data was found. Check the selected workspace, time range, and collection prerequisites.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "NetworkCoveragePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "TcpFallbackPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "SessionsWithErrorsPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgRTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
