    {
      "type": 1,
      "content": {
        "json": "## Client and path readiness\r\nUse these panels to identify outdated or unusual AVD client populations and users who never establish UDP. They do **not** report whether Teams media optimization is enabled; confirm optimization status in Teams/CQD or endpoint inventory."
      },
      "name": "Client and path section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),ClientOS=iff(isempty(ClientOS),\"Unknown\",ClientOS),ClientType=iff(isempty(ClientType),\"Unknown\",ClientType),ClientVersion=iff(isempty(ClientVersion),\"Unknown\",ClientVersion)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,ClientOS,ClientType,ClientVersion,Transport,User);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize AvgRTTms=avg(EstRoundTripTimeInMs),P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nC|join kind=leftouter N on CorrelationId|summarize Sessions=count(),Users=dcount(User),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),AvgRTTms=round(avg(AvgRTTms),1),P95RTTms=round(max(P95RTTms),1),P10BandwidthMbps=round(min(P10BandwidthMbps),2) by ClientOS,ClientType,ClientVersion|extend TcpFallbackPct=round(100.0*TcpFallbackSessions/iff(Sessions==0,1,Sessions),1)|order by TcpFallbackPct desc,Sessions desc",
        "size": 0,
        "title": "Client version and AVD transport readiness",
        "description": "Groups sessions by AVD client OS, type, and version and shows TCP fallback plus network quality. A version with unusually high fallback or latency is a candidate for targeted validation. This is not a Teams optimization-status measurement.",
        "noDataMessage": "No data was found for the selected filters. Review the panel prerequisites and diagnostic coverage.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
