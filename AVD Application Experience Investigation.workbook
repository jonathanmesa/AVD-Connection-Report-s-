      },
      "name": "Session host transport and bandwidth",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}));WVDCheckpoints|where TimeGenerated {TimeRange}|where Name==\"LogonDelay\"|join kind=inner (C|project CorrelationId,HostPool,Gateway,User,SessionHostName) on CorrelationId|extend AuthenticationMs=todouble(Parameters.AuthenticateUser),LogonTotalMs=todouble(Parameters.WinLogon_Total),GpoMs=todouble(Parameters.WinLogon_Logon_GPClient),ProfileMs=todouble(Parameters.WinLogon_Logon_Profiles),EventNotificationMs=todouble(Parameters.WinLogon_Logon_Sens),SessionEnvironmentMs=todouble(Parameters.WinLogon_Logon_SessionEnv),TerminalServicesMs=todouble(Parameters.WinLogon_Logon_TermSrv),FsLogixMs=todouble(Parameters.WinLogon_Logon_frxsvc),StartShellMs=todouble(Parameters.WinLogon_StartShell)|summarize Logons=count(),TotalLogonMin=round(sum(LogonTotalMs)/60000.0,2),AvgAuthenticationSec=round(avg(AuthenticationMs)/1000.0,1),P95AuthenticationSec=round(percentile(AuthenticationMs,95)/1000.0,1),AvgLogonTotalMin=round(avg(LogonTotalMs)/60000.0,2),P95LogonTotalMin=round(percentile(LogonTotalMs,95)/60000.0,2),AvgGpoSec=round(avg(GpoMs)/1000.0,1),AvgProfileSec=round(avg(ProfileMs)/1000.0,1),AvgEventNotificationSec=round(avg(EventNotificationMs)/1000.0,1),AvgSessionEnvironmentSec=round(avg(SessionEnvironmentMs)/1000.0,1),AvgTerminalServicesSec=round(avg(TerminalServicesMs)/1000.0,1),AvgFsLogixSec=round(avg(FsLogixMs)/1000.0,1),AvgStartShellSec=round(avg(StartShellMs)/1000.0,1) by HostPool,SessionHostName|order by P95LogonTotalMin desc,Logons desc",
        "size": 0,
        "title": "Logon timing and slow phases",
        "description": "Each row is one session host. P95 logon total is the slowest 5% of logons and is the first value to compare. Then identify the largest phase: GPO, profile, FSLogix, or shell start. A high phase on one host points to the next remediation target. No rows means LogonDelay telemetry is unavailable for this period.",
        "noDataMessage": "No LogonDelay checkpoints were found. Enable WVDCheckpoints diagnostic collection and widen the time range if needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "HostPool",
              "label": "Host pool"
            },
            {
              "columnId": "SessionHostName",
              "label": "Session host"
            },
            {
              "columnId": "Logons",
              "label": "Logons",
              "width": "8ch"
            },
            {
              "columnId": "TotalLogonMin",
              "label": "Total logon time (min)",
              "width": "14ch"
            },
            {
              "columnId": "AvgAuthenticationSec",
              "label": "Avg authentication (sec)",
              "width": "14ch"
            },
            {
              "columnId": "P95AuthenticationSec",
              "label": "P95 authentication (sec)",
              "width": "14ch"
            },
            {
              "columnId": "AvgLogonTotalMin",
              "label": "Avg logon total (min)",
              "width": "14ch"
            },
            {
              "columnId": "P95LogonTotalMin",
              "label": "P95 logon total (min)",
              "width": "14ch"
            },
            {
              "columnId": "AvgGpoSec",
              "label": "Avg GPO (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgProfileSec",
              "label": "Avg profile (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgFsLogixSec",
              "label": "Avg FSLogix (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgStartShellSec",
              "label": "Avg shell start (sec)",
              "width": "12ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "P95AuthenticationSec",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "60",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95LogonTotalMin",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "2",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgFsLogixSec",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Logon timing and slow phases",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct SessionHostName;WVDAgentHealthStatus|where TimeGenerated {TimeRange}|where SessionHostName in (C)|where EndpointState =~ \"Unhealthy\" and isnotempty(SessionHostHealthCheckResult)|mv-expand Check=SessionHostHealthCheckResult|where tostring(Check.HealthCheckResult) != \"1\"|summarize arg_max(TimeGenerated,*) by SessionHostName,HealthCheck=tostring(Check.HealthCheckResult),FailureMessage=tostring(Check.AdditionalFailureDetails.Message)|project SessionHostName,EndpointState,HealthCheck,FailureMessage,AgentVersion,SxSStackVersion,TimeGenerated|order by TimeGenerated desc",
        "size": 0,
        "title": "Unhealthy session hosts and failed health checks",
        "description": "Shows the latest failed AVD agent health checks for session hosts reporting an Unhealthy endpoint state. Review the failure details first, then compare agent and SxS stack versions across hosts. Messages such as an unavailable SxS listener, stopped Remote Desktop Configuration service, or lost domain trust indicate a host or agent problem rather than a client transport problem. Results require WVDAgentHealthStatus collection and are limited by the selected time range.",
        "noDataMessage": "No unhealthy session hosts or failed health checks were found.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "HostPool",
              "label": "Host pool"
            },
            {
              "columnId": "SessionHostName",
              "label": "Session host"
            },
            {
              "columnId": "HealthCheck",
              "label": "Failed health check"
            },
            {
              "columnId": "FailureMessage",
              "label": "Failure details"
            },
            {
              "columnId": "AgentVersion",
              "label": "Agent version"
            },
            {
              "columnId": "SxSStackVersion",
              "label": "SxS stack version"
            },
            {
              "columnId": "TimeGenerated",
              "label": "Last reported",
              "width": "16ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "EndpointState",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Unhealthy",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Unhealthy session hosts and failed health checks",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,HostPool;WVDConnectionGraphicsDataPreview|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ServerSkippedFramesPct=round(avg(ServerSkippedFramesPercentage),2),ClientSkippedFramesPct=round(avg(ClientSkippedFramesPercentage),2),NetworkSkippedFramesPct=round(avg(NetworkSkippedFramesPercentage),2),ServerEncodingDelayMs=round(avg(EncodingDelayOnServerInMs),1),ClientDecodingDelayMs=round(avg(DecodingTimeOnClientInMs),1),ClientRenderingTimeMs=round(avg(RenderingTimeOnClientInMs),1),Samples=count() by HostPool|order by NetworkSkippedFramesPct desc,ClientSkippedFramesPct desc",
        "size": 0,
        "title": "Graphics performance by host pool",
        "description": "Summarizes graphics telemetry by host pool, including server-skipped, client-skipped, and network-skipped frame percentages plus server encoding, client decoding, and client rendering delay in milliseconds. Network-skipped frames suggest transport or path instability; decoding or rendering delay suggests endpoint, display, GPU, or client workload pressure. This panel requires WVDConnectionGraphicsDataPreview collection and is independent of RTT and bandwidth coverage.",
        "noDataMessage": "No graphics performance data was found. Enable the graphics diagnostic data collection if supported in the environment.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "HostPool",
              "label": "Host pool"
            },
            {
              "columnId": "Samples",
              "label": "Samples",
              "width": "8ch"
            },
            {
              "columnId": "ServerSkippedFramesPct",
              "label": "Server skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "ClientSkippedFramesPct",
              "label": "Client skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "NetworkSkippedFramesPct",
              "label": "Network skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "ServerEncodingDelayMs",
              "label": "Server encoding (ms)",
              "width": "14ch"
            },
            {
              "columnId": "ClientDecodingDelayMs",
              "label": "Client decoding (ms)",
              "width": "14ch"
            },
            {
              "columnId": "ClientRenderingTimeMs",
              "label": "Client rendering (ms)",
              "width": "14ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "ServerSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "ClientSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "NetworkSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "ServerEncodingDelayMs",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "15",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "ClientDecodingDelayMs",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
