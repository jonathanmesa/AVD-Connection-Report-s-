          ],
          "formatters": [
            {
              "columnMatch": "TCP_Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "50",
