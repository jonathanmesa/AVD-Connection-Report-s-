    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize LinkCount=dcount(LinkId),ClientTransports=make_set(ClientTransportType),ServerTransports=make_set(ServerTransportType),ClientTURNIPs=make_set_if(ClientTURNIP,isnotempty(ClientTURNIP)),ServerTURNIPs=make_set_if(ServerTURNIP,isnotempty(ServerTURNIP)),T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|summarize NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by CorrelationId;let E=WVDErrors|where TimeGenerated {TimeRange}|summarize ErrorCount=count(),ErrorDetails=make_set(strcat(iff(isempty(CodeSymbolic),tostring(Code),CodeSymbolic),\" | \" ,ActivityType,\" | \" ,Operation,\" | \" ,Source,\" | \" ,Message),10) by CorrelationId;WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0)),LinkCount=coalesce(LinkCount,long(0)),NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorCount=coalesce(ErrorCount,long(0))|extend Mode=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),TransportDetail=case(Mode==\"UDP via TURN\",\"Relayed (public network, TURN)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"1\",\"Direct (managed network, private)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"2\",\"Direct (public network, STUN)\",Mode==\"UDP direct\",\"Direct (Shortpath/Multipath link evidence)\",Mode==\"TCP fallback\",\"TCP reverse-connect\",\"Unclassified\"),ObservedEvidence=case(Mode==\"UDP via TURN\",\"TURN transport, TURN IP, or documented UdpUse=4 present\",Mode==\"UDP direct\",\"DIRECT link, Multipath, documented UdpUse=1/2, or MultiLinkAdd evidence present without TURN\",Mode==\"TCP fallback\",\"WebSocket transport present without UDP evidence\",\"No decisive transport evidence\"),Interpretation=case(Mode==\"UDP via TURN\",\"UDP active through relay\",Mode==\"UDP direct\",\"Direct UDP Shortpath active\",Mode==\"TCP fallback\",\"Reverse-connect TCP/TLS 443 used; UDP Shortpath not established or not reported\",\"Do not assume TCP; validate diagnostic coverage\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project TimeGenerated,Transport=Mode,TransportDetail,User=UserName,HostPool,Gateway,SessionHost=SessionHostName,ClientOS,ClientType,ClientVersion,ObservedEvidence,Interpretation,NetworkSamples,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps,ErrorCount,ErrorDetails,CorrelationId|order by User asc,TimeGenerated desc",
        "size": 0,
        "title": "Session transport, RTT, and bandwidth details",
        "description": "One row per session matching the current filters, sorted by user and then most recent session first, so every session that belongs to the same user appears together in one block instead of being scattered across the whole time range. Error details lists up to 10 raw WVDErrors entries (code | activity | operation | source | message) for that session's CorrelationId, so you don't need to cross-reference WVDErrors separately to see what actually went wrong. When 'All' users are selected there can be a lot of users to scan — use the 'Search or select user' pill in the filters above to narrow this entire table (and every other panel) down to one user's full session history.",
        "noDataMessage": "No sessions match the current filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 10000,
          "labelSettings": [
            {
              "columnId": "TransportDetail",
              "label": "Transport detail"
            },
            {
              "columnId": "Interpretation",
              "label": "What this means"
            },
            {
              "columnId": "NetworkSamples",
              "label": "Network samples",
              "width": "10ch"
            },
            {
              "columnId": "AvgRTTms",
              "label": "Avg RTT (ms)",
              "width": "10ch"
