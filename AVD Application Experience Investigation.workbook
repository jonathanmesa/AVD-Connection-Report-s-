    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,User,HostPool,Gateway,SessionHost,Transport);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSamples=count(),AvgRTTms=avg(EstRoundTripTimeInMs),P95RTTms=percentile(EstRoundTripTimeInMs,95),AvgBandwidthMbps=avg(EstAvailableBandwidthKBps)*8.0/1000,P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nlet E=WVDErrors|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ErrorEvents=count() by CorrelationId;\r\nC|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorEvents=coalesce(ErrorEvents,long(0))|summarize Sessions=count(),NetworkSessions=countif(NetworkSamples>0),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),ErrorEvents=sum(ErrorEvents),AvgRTTms=round(avg(AvgRTTms),1),P95RTTms=round(max(P95RTTms),1),AvgBandwidthMbps=round(avg(AvgBandwidthMbps),2),P10BandwidthMbps=round(min(P10BandwidthMbps),2),HostPools=make_set(HostPool,5),SessionHosts=make_set(SessionHost,10),Gateways=make_set(Gateway,5) by User|extend NetworkCoveragePct=round(100.0*NetworkSessions/iff(Sessions==0,1,Sessions),1),TcpFallbackPct=round(100.0*TcpFallbackSessions/iff(Sessions==0,1,Sessions),1)|extend Risk=case(P95RTTms>250 or P10BandwidthMbps<5 or TcpFallbackPct>50 or ErrorEvents>5,\"High\",P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20 or ErrorEvents>2,\"Medium\",\"Low\"),RiskSort=case(P95RTTms>250 or P10BandwidthMbps<5 or TcpFallbackPct>50 or ErrorEvents>5,1,P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20 or ErrorEvents>2,2,3)|project Risk,User,Sessions,NetworkCoveragePct,TcpFallbackPct,ErrorEvents,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps,HostPools,SessionHosts,Gateways,RiskSort|order by RiskSort asc,P95RTTms desc,Sessions desc",
        "size": 0,
        "title": "User experience triage for application complaints",
        "description": "Ranks users using AVD-side evidence: network coverage, TCP fallback, errors, RTT, and estimated bandwidth. High risk means one or more strong AVD risk signals were observed; it does not establish the cause of an application-specific symptom.",
        "noDataMessage": "No data was found for the selected filters. Review the panel prerequisites and diagnostic coverage.",
