    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,User,HostPool,Gateway,SessionHost;\r\nWVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize Sessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by TimeBucket=bin(TimeGenerated,30m),User,HostPool,Gateway,SessionHost|extend AVDPathRisk=case(P95RTTms>250 or P10BandwidthMbps<5,\"High\",P95RTTms>120 or P10BandwidthMbps<10,\"Medium\",\"Low\")|order by TimeBucket desc,User asc",
        "size": 0,
        "title": "30-minute AVD evidence export",
        "description": "Export this dataset and align it with application events or complaint timestamps by User and TimeBucket. SessionHost, HostPool, and Gateway help identify whether complaints cluster around infrastructure or a regional path. The fixed 30-minute bucket supports correlation across data sources.",
        "noDataMessage": "No data was found for the selected filters. Review the panel prerequisites and diagnostic coverage.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
