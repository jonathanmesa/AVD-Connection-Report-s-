                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Complaint cohort comparison",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,Transport);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nlet S=C|join kind=leftouter N on CorrelationId|extend HasNetwork=isnotnull(P95RTTms)|summarize Sessions=count(),SampledSessions=countif(HasNetwork),HighLatencySessions=countif(HasNetwork and P95RTTms>250),ConstrainedBandwidthSessions=countif(HasNetwork and P10BandwidthMbps<5),TcpFallbackSessions=countif(Transport==\"TCP fallback\");\r\nunion (S|project Sort=1,Metric=\"Connected sessions\",Value=todouble(Sessions),Description=\"Sessions in the selected scope\",Status=\"Scope\"),(S|project Sort=2,Metric=\"Network coverage (%)\",Value=round(100.0*SampledSessions/iff(Sessions==0,1,Sessions),1),Description=\"Sessions with RTT and bandwidth samples\",Status=case(Sessions==0,\"Unknown\",100.0*SampledSessions/Sessions<50,\"High\",100.0*SampledSessions/Sessions<80,\"Medium\",\"Low\")),(S|project Sort=3,Metric=\"High-latency sessions (%)\",Value=round(100.0*HighLatencySessions/iff(SampledSessions==0,1,SampledSessions),1),Description=\"P95 AVD RTT above 250 ms among sampled sessions\",Status=case(SampledSessions==0,\"Unknown\",100.0*HighLatencySessions/SampledSessions>20,\"High\",100.0*HighLatencySessions/SampledSessions>5,\"Medium\",\"Low\")),(S|project Sort=4,Metric=\"Constrained sessions (%)\",Value=round(100.0*ConstrainedBandwidthSessions/iff(SampledSessions==0,1,SampledSessions),1),Description=\"P10 estimated bandwidth below 5 Mbps among sampled sessions\",Status=case(SampledSessions==0,\"Unknown\",100.0*ConstrainedBandwidthSessions/SampledSessions>20,\"High\",100.0*ConstrainedBandwidthSessions/SampledSessions>5,\"Medium\",\"Low\")),(S|project Sort=5,Metric=\"TCP fallback (%)\",Value=round(100.0*TcpFallbackSessions/iff(Sessions==0,1,Sessions),1),Description=\"Sessions without an observed UDP path\",Status=case(Sessions==0,\"Unknown\",100.0*TcpFallbackSessions/Sessions>50,\"High\",100.0*TcpFallbackSessions/Sessions>20,\"Medium\",\"Low\"))|order by Sort asc",
        "size": 0,
        "title": "Application experience: AVD path risk overview",
        "description": "AVD-side indicators that can affect interactive applications. High-latency and constrained-bandwidth percentages use only sessions with network samples; Network coverage shows the denominator quality. These are AVD path measurements, not application transaction timings.",
        "noDataMessage": "No data was found for the selected filters. Review the panel prerequisites and diagnostic coverage.",
