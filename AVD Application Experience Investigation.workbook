          "formatters": [
            {
              "columnMatch": "Transport",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "gray",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "TCP fallback",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "UDP via TURN",
                    "representation": "yellow",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "UDP direct",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgRTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgBandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "ErrorCount",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        },
        "sortBy": [
          {
            "itemKey": "User",
            "sortOrder": 1
          },
          {
            "itemKey": "TimeGenerated",
            "sortOrder": 2
          }
        ]
      },
      "name": "Session transport evidence",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Optional operational diagnostics`r`nThese sources explain changes around the AVD environment. They are most useful when symptoms began after a host, image, scaling, provisioning, or resource-publication change. Missing optional sources are an evidence gap, not an AVD health result."
      },
      "name": "Optional operational diagnostics section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WVDFeeds|where TimeGenerated {TimeRange}|extend User=iff(isempty(UserName),\"Unknown\",UserName),Client=iff(isempty(ClientType),\"Unknown\",ClientType),Version=iff(isempty(ClientVersion),\"Unknown\",ClientVersion)|where ('All' in ({UserFilter}) or User in ({UserFilter}))|summarize FeedRequests=count(),RdpFailures=sum(RDPFail),RdpFiles=sum(RDPTotal),IconFailures=sum(IconFail),Icons=sum(IconTotal),LastSeen=max(TimeGenerated) by User,Client,Version|extend RetrievalFailurePct=round(100.0*todouble(RdpFailures+IconFailures)/todouble(max_of(RdpFiles+Icons,1)),2)|project User,Client,Version,FeedRequests,RdpFailures,IconFailures,RetrievalFailurePct,LastSeen|order by RetrievalFailurePct desc,FeedRequests desc",
        "size": 0,
        "title": "Workspace feed and resource retrieval failures",
        "description": "Use this when users cannot see, launch, or refresh assigned desktops or RemoteApps. Each row is a user and client version. Red means published RDP files or icons failed to download. This diagnoses AVD resource discovery, not in-session application speed.",
        "noDataMessage": "No WVDFeeds records were found. Enable the Feed diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "RetrievalFailurePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "AVD feed retrieval failures",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool,SessionHostName;WVDHostRegistrations|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|join kind=inner C on HostPool,SessionHostName|summarize Registrations=count(),FirstRegistration=min(TimeGenerated),LastRegistration=max(TimeGenerated),PrivateLink=make_set(IsSessionHostPrivateLink,2),Addresses=make_set(SessionHostIPAddress,3) by HostPool,SessionHostName|order by LastRegistration desc",
        "size": 0,
        "title": "Session host registration activity",
        "description": "Use this after hosts are added, rebuilt, or updated. Each row shows when a session host last registered with AVD. Repeated or unexpected registrations can identify hosts changed around the start of a user-experience issue.",
        "noDataMessage": "No WVDHostRegistrations records were found. Enable the Host Registration diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "Session host registration activity",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool;WVDManagement|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Scope=iff(isempty(ArmObjectScope),\"Unknown\",ArmObjectScope),Actor=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where HostPool in (C)|summarize Operations=count(),Created=sum(ObjectsCreated),Updated=sum(ObjectsUpdated),Deleted=sum(ObjectsDeleted),FirstSeen=min(TimeGenerated),LastSeen=max(TimeGenerated),SampleActors=make_set(Actor,5) by HostPool,Scope,Route,ProvisioningCorrelationId|order by LastSeen desc",
        "size": 0,
        "title": "AVD management changes near an incident",
        "description": "Use this to find AVD resource changes that occurred before symptoms began. Each row is a management route and scope. Review recent creates, updates, and deletes before attributing a broad regression to the network path.",
        "noDataMessage": "No WVDManagement records were found. Enable the Management diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "AVD management changes",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool;WVDSessionHostManagement|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where HostPool in (C)|project TimeGenerated,HostPool,ProvisioningType,ProvisioningStatus,FromInstanceCount,ToInstanceCount,FromSessionHostConfigVer,ToSessionHostConfigVer,UpdateMethod,ScheduledDateTime,CorrelationId|order by TimeGenerated desc",
        "size": 0,
        "title": "Session host provisioning and updates",
        "description": "Use this when the issue followed host provisioning, image rollout, or host configuration change. Each row is an AVD session-host management operation. Failed status or a configuration-version change identifies a specific deployment window to compare with affected users.",
        "noDataMessage": "No WVDSessionHostManagement records were found. Enable the Session Host Management diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "Session host provisioning and updates",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool;WVDAutoscaleEvaluationPooled|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where HostPool in (C)|project TimeGenerated,HostPool,ResultType,ConfigScheduleName,ConfigSchedulePhase,SessionCount,ActiveSessionHostCount,TotalSessionHostCount,SessionOccupancyPercent,ConfigCapacityThresholdPercent,UnhealthySessionHostCount,ScalingReasonMessage,CorrelationId|order by TimeGenerated desc",
        "size": 0,
        "title": "Autoscale occupancy and scaling decisions",
        "description": "Use this when complaints cluster around a time of day or after hosts were started or deallocated. Each row is an Autoscale evaluation. Compare occupancy, active-host count, unhealthy hosts, and the scaling reason with the complaint time. Failed results should be investigated with matching AVD errors by CorrelationId.",
        "noDataMessage": "No WVDAutoscaleEvaluationPooled records were found. Enable the Autoscale diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "ResultType",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Failed",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Succeeded",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Autoscale occupancy and scaling decisions",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Complete the application root-cause record outside this workbook\r\n- **Application telemetry:** application-specific latency, failure, service health, client diagnostics, and timestamps.\r\n- **Network and security telemetry:** proxy, DNS, identity, firewall, TLS inspection, and content-path evidence.\r\n- **Profile and endpoint telemetry:** profile behavior, endpoint configuration, and client-side evidence where relevant.\r\n- **Correlation rule:** compare the same user and time window. Healthy AVD evidence during poor application telemetry shifts investigation toward the application, service, profile, endpoint, proxy, or content path."
      },
      "name": "App evidence checklist",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    }
  ],
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "layout": {
    "type": "flow"
  }
}